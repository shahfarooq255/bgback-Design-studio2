a-type=\"text\" style=\"position:absolute;bottom:180px;left:0;width:100%;text-align:center;color:#4a4238 !important;font-size:85px;font-weight:400;font-family:'Playfair Display',serif;z-index:5;margin:0;line-height:1;font-style:italic;\">Effortless Grace</h1>\n                \n                <div class=\"hd-draggable\" data-type=\"text\" style=\"position:absolute;bottom:80px;left:50%;transform:translateX(-50%);border-bottom:1px solid #4a4238;color:#4a4238 !important;padding-bottom:5px;font-size:18px;font-weight:600;z-index:6;font-family:'Inter',sans-serif;letter-spacing:2px;text-transform:uppercase;cursor:pointer;\">View Collection</div>\n                "
